---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
const reading = (await getCollection('reading')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())[0];
// what the book on the desk prints on its pages
const readingData = reading
	? {
			title: reading.data.title,
			author: reading.data.author,
			status: reading.data.status,
			progress: reading.data.progress,
			updated: reading.data.updated.toISOString(),
			entries: reading.data.entries.map((e) => ({ page: e.page, date: e.date?.toISOString(), note: e.note })),
		}
	: null;

// From the GitHub profile README.
const projects = [
	{ name: 'Launcher', what: 'Pocket mission control on a LilyGO T-Display S3: launch-sequence state machine, live IMU telemetry over MQTT and a mission event log.', stack: 'C · ESP-IDF', href: 'https://github.com/aayushpx/Launcher' },
	{ name: 'Neo', what: 'A Matrix-themed dodge game for the T-Display S3, with procedural Matrix rain, a ramping difficulty curve and a high score saved to flash.', stack: 'C · ESP-IDF', href: 'https://github.com/aayushpx/neo' },
	{ name: 'Project Aphelion', what: 'Hardware-in-the-loop flight dynamics testbed: an ESP32 flight computer streams telemetry while Python propagates the trajectory. Paused while I study kinematics properly.', stack: 'C++ · Python', href: 'https://github.com/aayushpx/project-aphelion' },
	{ name: '16-bit CPU Simulator', what: 'A custom instruction set with a full fetch–decode–execute cycle, registers and memory.', stack: 'C++', href: 'https://github.com/aayushpx/16bit-cpu-simulator' },
	{ name: 'Software Rasterizer', what: 'A 2D renderer from raw pixel writes. No graphics API, just maths and memory.', stack: 'C++', href: 'https://github.com/aayushpx/cpp-rasterizer' },
	{ name: 'Connected Component Detector', what: 'DFS flood-fill over raw PPM images to find and classify regions. No libraries.', stack: 'C++', href: 'https://github.com/aayushpx/connected-component-detector' },
	{ name: 'statsforensics', what: 'An R package for exploratory analysis, hypothesis testing, regression and diagnostics.', stack: 'R', href: 'https://github.com/aayushpx/statistical-analysis-toolkit' },
];
const hackathons = [
	{ name: 'SPHERExPLORER', note: '3rd place, NASA Space Apps NZ 2026', href: 'https://github.com/CelestiAI-Org/spherex' },
	{ name: 'Exoplanet Explorer', note: '2nd place, NASA Space Apps NZ 2025', href: 'https://github.com/CelestiAI-Org/nasa-hackathon-2025' },
	{ name: 'OrbitGuard', note: 'Built in 24 hours at ActInSpace NZ 2026', href: 'https://github.com/CelestiAI-Org/Orbitguard' },
	{ name: 'Midnight HR', note: 'Privacy-preserving salary verification, Midnight Hackathon 2026', href: 'https://github.com/CelestiAI-Org/midnight-hackathon' },
	{ name: 'MLH Global Hack Week: Agents', note: 'Six builds in one week, 2026', href: 'https://github.com/aayushpx/forge' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Aayush Prakash" description="Embedded systems, simulation and ML. My desk, from above and through my eyes." />
		<script is:inline>
			// Day or night follows the time in New Zealand (where the desk is),
			// unless you've flipped the light bar this visit. Set before first paint.
			(function () {
				var night;
				try {
					var saved = sessionStorage.getItem('desk-light');
					if (saved) night = saved === 'night';
				} catch (e) {}
				if (night === undefined) {
					var h = +new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', hour: 'numeric', hourCycle: 'h23' }).format(new Date());
					night = h < 7 || h >= 19;
				}
				document.documentElement.dataset.light = night ? 'night' : 'day';
			})();
		</script>
	</head>
	<body class="desk-page">
		<div class="track" id="track">
			<div class="stage">
				<canvas id="desk" aria-label="A 3D view of Aayush's desk"></canvas>

				<header class="hud">
					<div>
						<a class="name" href="/">aayush prakash</a>
						<p class="nz" id="nz-time"></p>
					</div>
					<button class="lamp" id="lamp" type="button" aria-pressed="false" title="Toggle the monitor light bar (L)">
						<span class="lamp-dot" aria-hidden="true"></span>
						<span>Light bar</span>
					</button>
				</header>

				<p class="hint hint-scroll" id="hint-scroll">Scroll to sit down</p>
				<p class="hint hint-look" id="hint-look">
					<span class="mouse-only">Move to look around · click anything on the desk</span>
					<span class="touch-only">Swipe to look around · tap anything on the desk</span>
				</p>

				<div class="tooltip" id="tooltip" data-show="false" role="status">
					<strong></strong>
					<span></span>
				</div>

				<div class="fallback" id="fallback" hidden>
					<p>Your browser can't show the 3D desk, so here's the short version.</p>
					<p><a href="/blog">Writing</a> · <a href="/about">About</a></p>
				</div>
			</div>
		</div>

		<!-- Picked-up object: a small card beside it -->
		<aside class="card" id="card" hidden aria-live="polite">
			<h2 id="card-title"></h2>
			<p id="card-about"></p>
			<p class="card-help"><span class="mouse-only">Drag to turn it over.</span><span class="touch-only">Drag to turn it over.</span> Esc or click away to put it back.</p>
			<div class="card-actions">
				<button type="button" class="pill" id="card-flip" hidden>Flip it over <kbd>F</kbd></button>
				<button type="button" class="pill" data-close>Put it back</button>
			</div>
		</aside>

		<!-- The main monitor, opened up into the site -->
		<section class="screen" id="screen" hidden aria-label="Aayush's site">
			<div class="screen-bar">
				<span class="screen-path">~/aayush</span>
				<nav class="screen-tabs" aria-label="Sections">
					<a href="#s-home">Home</a>
					<a href="#s-projects">Projects</a>
					<a href="#s-hackathons">Hackathons</a>
					<a href="#s-writing">Writing</a>
				</nav>
				<button type="button" class="pill" data-close>Back to the desk</button>
			</div>
			<div class="screen-body" id="screen-body">
				<section id="s-home" class="screen-hero">
					<p class="kicker">Embedded systems, simulation and ML. Building toward aerospace.</p>
					<h1>Aayush Prakash</h1>
					<p class="lede">
						Most of my projects start with <em>“how hard could it be?”</em> and end with a breadboard covered in jumper
						wires. CS and Data Science in New Zealand.
					</p>
					<p class="links">
						<a href="https://github.com/aayushpx">GitHub</a>
						<a href="/blog">Writing</a>
						<a href="/about">About</a>
					</p>
				</section>

				<section id="s-projects">
					<h2>Projects</h2>
					<ul class="cards">
						{
							projects.map((p) => (
								<li>
									<a href={p.href}>
										<strong>{p.name}</strong>
										<span>{p.what}</span>
										<small>{p.stack}</small>
									</a>
								</li>
							))
						}
					</ul>
				</section>

				<section id="s-hackathons">
					<h2>Hackathons</h2>
					<ul class="rows">
						{
							hackathons.map((h) => (
								<li>
									<a href={h.href}>{h.name}</a>
									<span>{h.note}</span>
								</li>
							))
						}
					</ul>
				</section>

				<section id="s-writing">
					<h2>Writing</h2>
					<ul class="rows">
						{
							posts.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>{p.data.title}</a>
									<span><FormattedDate date={p.data.pubDate} /></span>
								</li>
							))
						}
					</ul>
					<p class="links"><a href="/blog">All writing</a></p>
				</section>
			</div>
		</section>

		<!-- The open book: page-turn controls. The pages themselves are in the 3D book. -->
		<div class="book-bar" id="book" hidden>
			<button type="button" class="pill" id="book-prev" aria-label="Previous page">←</button>
			<span id="book-label" aria-live="polite"></span>
			<button type="button" class="pill" id="book-next" aria-label="Next page">→</button>
			<button type="button" class="pill" data-close>Close the book</button>
		</div>
		{
			readingData && (
				<section class="sr-only" aria-label="Reading notes">
					<h2>
						{readingData.title} by {readingData.author}
					</h2>
					<ul>
						{readingData.entries.map((e) => (
							<li>
								{e.page !== undefined && `Page ${e.page}: `}
								{e.note}
							</li>
						))}
					</ul>
				</section>
			)
		}
		<script type="application/json" id="reading-data" set:html={JSON.stringify(readingData)} />


		<script>
			import { startDesk, type Mode } from '../scripts/desk/scene';

			const root = document.documentElement;
			const $ = (id: string) => document.getElementById(id)!;
			const canvas = $('desk') as HTMLCanvasElement;
			const lampBtn = $('lamp') as HTMLButtonElement;
			const card = $('card');
			const screen = $('screen');
			const book = $('book');
			const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			root.classList.toggle('touch', matchMedia('(hover: none)').matches);


			// "4:12 pm in New Zealand"
			const nz = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', hour: 'numeric', minute: '2-digit' });
			const tickClock = () => ($('nz-time').textContent = `${nz.format(new Date())} in New Zealand`);
			tickClock();
			setInterval(tickClock, 15_000);

			const isNight = () => root.dataset.light === 'night';
			lampBtn.setAttribute('aria-pressed', String(isNight()));

			let desk: Awaited<ReturnType<typeof startDesk>> | null = null;
			const toggle = () => {
				const next = !isNight();
				root.dataset.light = next ? 'night' : 'day';
				lampBtn.setAttribute('aria-pressed', String(next));
				try {
					sessionStorage.setItem('desk-light', next ? 'night' : 'day');
				} catch {}
				desk?.setNight(next);
			};
			lampBtn.addEventListener('click', toggle);
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') desk?.close();
				if (e.key.toLowerCase() === 'f' && !$('card').hidden) desk?.flip();
				if (!book.hidden && e.key === 'ArrowRight') desk?.turnPage(1);
				if (!book.hidden && e.key === 'ArrowLeft') desk?.turnPage(-1);
				const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea');
				if (!typing && e.key.toLowerCase() === 'l' && !e.metaKey && !e.ctrlKey && !e.altKey) toggle();
			});
			document.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => desk?.close()));
			$('card-flip').addEventListener('click', () => desk?.flip());
			$('book-prev').addEventListener('click', () => desk?.turnPage(-1));
			$('book-next').addEventListener('click', () => desk?.turnPage(1));

			function show(el: HTMLElement, on: boolean) {
				if (on) {
					el.hidden = false;
					requestAnimationFrame(() => el.classList.add('open'));
				} else {
					el.classList.remove('open');
					setTimeout(() => {
						if (!el.classList.contains('open')) el.hidden = true;
					}, 350);
				}
			}

			function setBook(info: { label: string; canPrev: boolean; canNext: boolean }) {
				$('book-label').textContent = info.label;
				($('book-prev') as HTMLButtonElement).disabled = !info.canPrev;
				($('book-next') as HTMLButtonElement).disabled = !info.canNext;
			}

			function webglOk() {
				try {
					const c = document.createElement('canvas');
					return !!(c.getContext('webgl2') || c.getContext('webgl'));
				} catch {
					return false;
				}
			}

			if (!webglOk()) {
				$('fallback').hidden = false;
				$('track').classList.add('no-3d');
			} else {
				const hintScroll = $('hint-scroll');
				const hintLook = $('hint-look');
				startDesk({
					canvas,
					scrollTrack: $('track'),
					tooltip: $('tooltip'),
					reducedMotion,
					night: isNight(),
					onLightBarClick: toggle,
					reading: JSON.parse($('reading-data').textContent || 'null'),
					onProgress(p) {
						hintScroll.style.opacity = String(Math.max(0, 1 - p * 5));
						hintLook.style.opacity = String(Math.max(0, (p - 0.9) * 10));
					},
					ui: {
						showCard(item) {
							$('card-title').textContent = item.label;
							$('card-about').textContent = item.about ?? item.hint;
							$('card-flip').hidden = !item.flippable;
							show(card, true);
						},
						hideCard: () => show(card, false),
						showScreen(section) {
							show(screen, true);
							const target = document.getElementById(`s-${section}`);
							$('screen-body').scrollTop = target && section !== 'home' ? target.offsetTop - 70 : 0;
							(screen.querySelector('[data-close]') as HTMLElement).focus({ preventScroll: true });
						},
						hideScreen: () => show(screen, false),
						showBook(info) {
							setBook(info);
							show(book, true);
						},
						updateBook: (info) => setBook(info),
						hideBook: () => show(book, false),
						modeChanged(m: Mode) {
							root.dataset.mode = m;
						},
					},
				})
					.then((d) => {
						desk = d;
						root.classList.add('desk-ready');
					})
					.catch((err) => {
						console.error(err);
						$('fallback').hidden = false;
					});
			}
		</script>

		<style is:global>
			:root[data-light='day'] {
				--desk-bg: #d9d6cf;
				--desk-ink: #1d1f24;
				--desk-soft: rgba(29, 31, 36, 0.62);
				--desk-chip: rgba(255, 255, 255, 0.78);
				--desk-chip-line: rgba(29, 31, 36, 0.12);
			}
			:root[data-light='night'] {
				--desk-bg: #0b0d12;
				--desk-ink: #f1ede4;
				--desk-soft: rgba(241, 237, 228, 0.62);
				--desk-chip: rgba(20, 22, 28, 0.78);
				--desk-chip-line: rgba(241, 237, 228, 0.14);
			}
			:root {
				--mango: #f2a516;
				--screen-bg: #0e1014;
				--screen-ink: #eeeae1;
				--screen-soft: rgba(238, 234, 225, 0.62);
				--paper: #f4efe3;
				--paper-ink: #2a2620;
			}
			:root.desk-locked {
				overflow: hidden;
			}
			.card[hidden],
			.screen[hidden],
			.book-bar[hidden] {
				display: none !important;
			}
			body.desk-page {
				background: var(--desk-bg);
				color: var(--desk-ink);
				transition: background-color 0.8s ease;
			}
			.touch-only {
				display: none;
			}
			:root.touch .touch-only {
				display: inline;
			}
			:root.touch .mouse-only {
				display: none;
			}
		</style>

		<style>
			.track {
				height: 320vh;
				position: relative;
			}
			.track.no-3d {
				height: 100vh;
			}
			.stage {
				position: sticky;
				top: 0;
				height: 100vh;
				height: 100svh;
				overflow: hidden;
			}
			canvas {
				display: block;
				width: 100%;
				height: 100%;
				opacity: 0;
				transition: opacity 0.9s ease;
				/* vertical swipes scroll the page; horizontal ones look around */
				touch-action: pan-y;
			}
			:global(.desk-ready) canvas {
				opacity: 1;
			}

			.hud {
				position: absolute;
				inset: 0 0 auto 0;
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				padding: 16px;
				pointer-events: none;
			}
			.hud > * {
				pointer-events: auto;
			}
			.name {
				color: var(--desk-ink);
				text-decoration: none;
				font-weight: 700;
				font-size: 17px;
			}
			.nz {
				margin: 2px 0 0;
				font-size: 13px;
				color: var(--desk-soft);
			}
			.lamp,
			.pill {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				font: inherit;
				font-size: 15px;
				color: var(--desk-ink);
				background: var(--desk-chip);
				border: 1px solid var(--desk-chip-line);
				border-radius: 999px;
				padding: 7px 14px;
				cursor: pointer;
				backdrop-filter: blur(8px);
			}
			.lamp {
				padding-left: 10px;
			}
			.lamp:focus-visible,
			.pill:focus-visible {
				outline: 2px solid var(--mango);
				outline-offset: 2px;
			}
			.lamp-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: #8a8a8a;
				transition:
					background-color 0.4s ease,
					box-shadow 0.4s ease;
			}
			.lamp[aria-pressed='true'] .lamp-dot {
				background: #ffd29a;
				box-shadow: 0 0 10px 3px rgba(255, 196, 120, 0.6);
			}

			.hint {
				position: absolute;
				left: 50%;
				bottom: 28px;
				transform: translateX(-50%);
				margin: 0;
				font-size: 15px;
				color: var(--desk-soft);
				background: var(--desk-chip);
				border: 1px solid var(--desk-chip-line);
				border-radius: 999px;
				padding: 6px 14px;
				white-space: nowrap;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.hint-look {
				opacity: 0;
			}
			:global(:root[data-mode='inspect']) .hint,
			:global(:root[data-mode='book']) .hint,
			:global(:root[data-mode='screen']) .hint {
				visibility: hidden;
			}

			.tooltip {
				position: fixed;
				left: 0;
				top: 0;
				max-width: 260px;
				padding: 8px 12px;
				border-radius: 10px;
				background: var(--desk-chip);
				border: 1px solid var(--desk-chip-line);
				backdrop-filter: blur(8px);
				color: var(--desk-ink);
				font-size: 14px;
				line-height: 1.35;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.tooltip[data-show='true'] {
				opacity: 1;
			}
			.tooltip strong {
				display: block;
				font-size: 15px;
			}
			.tooltip span {
				color: var(--desk-soft);
			}

			/* ---------------------------------------------------------------- card */
			.card {
				position: fixed;
				z-index: 20;
				right: max(16px, 5vw);
				top: 50%;
				width: min(340px, calc(100vw - 32px));
				transform: translate(16px, -50%);
				opacity: 0;
				transition:
					opacity 0.35s ease,
					transform 0.35s ease;
				padding: 20px 22px;
				border-radius: 16px;
				background: rgba(20, 22, 28, 0.82);
				color: #f1ede4;
				border: 1px solid rgba(241, 237, 228, 0.12);
				backdrop-filter: blur(10px);
				line-height: 1.5;
			}
			.card:global(.open) {
				opacity: 1;
				transform: translate(0, -50%);
			}
			.card h2 {
				color: #fff;
				font-size: 24px;
				margin: 0 0 8px;
			}
			.card p {
				margin: 0 0 12px;
				font-size: 16px;
			}
			.card .card-help {
				font-size: 13px;
				color: rgba(241, 237, 228, 0.6);
			}
.card-actions {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.card kbd {
				font: 600 11px ui-monospace, monospace;
				padding: 1px 5px;
				border-radius: 4px;
				background: rgba(255, 255, 255, 0.12);
			}
			.card .pill[hidden] {
				display: none;
			}
			.card .pill {
				color: #f1ede4;
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(255, 255, 255, 0.16);
			}
			@media (max-aspect-ratio: 11/10) {
				.card {
					top: auto;
					bottom: 16px;
					left: 16px;
					right: 16px;
					width: auto;
					transform: translateY(16px);
				}
				.card:global(.open) {
					transform: none;
				}
			}

			/* ---------------------------------------------------------------- screen (the site) */
			.screen {
				position: fixed;
				inset: 0;
				z-index: 30;
				display: flex;
				flex-direction: column;
				background: var(--screen-bg);
				color: var(--screen-ink);
				opacity: 0;
				transition: opacity 0.4s ease;
			}
			.screen:global(.open) {
				opacity: 1;
			}
			.screen-bar {
				display: flex;
				align-items: center;
				gap: 16px;
				padding: 10px 16px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				font-size: 14px;
			}
			.screen-path {
				font-family: ui-monospace, monospace;
				color: var(--mango);
			}
			.screen-tabs {
				display: flex;
				gap: 14px;
				flex: 1;
				overflow-x: auto;
			}
			.screen-tabs a {
				color: var(--screen-soft);
				text-decoration: none;
				white-space: nowrap;
			}
			.screen-tabs a:hover {
				color: var(--screen-ink);
			}
			.screen .pill {
				color: var(--screen-ink);
				background: rgba(255, 255, 255, 0.06);
				border-color: rgba(255, 255, 255, 0.14);
				white-space: nowrap;
			}
			.screen-body {
				flex: 1;
				overflow-y: auto;
				scroll-behavior: smooth;
				padding: 0 16px 80px;
			}
			.screen-body > section {
				max-width: 820px;
				margin: 0 auto;
				padding-top: 56px;
			}
			.screen h1 {
				color: #fff;
				font-size: clamp(40px, 7vw, 72px);
				margin: 0 0 16px;
			}
			.screen h2 {
				color: #fff;
				font-size: 28px;
				margin: 0 0 18px;
			}
			.kicker {
				font-family: ui-monospace, monospace;
				font-size: 14px;
				color: var(--mango);
				margin: 0 0 12px;
			}
			.lede {
				font-size: 20px;
				color: var(--screen-soft);
				max-width: 620px;
			}
			.links {
				display: flex;
				gap: 20px;
				flex-wrap: wrap;
			}
			.screen a {
				color: var(--screen-ink);
				text-decoration-color: var(--mango);
				text-underline-offset: 4px;
			}
			.cards {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 12px;
			}
			.cards a {
				display: flex;
				flex-direction: column;
				gap: 6px;
				height: 100%;
				box-sizing: border-box;
				padding: 16px;
				border-radius: 12px;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.08);
				text-decoration: none;
				transition: border-color 0.2s ease;
			}
			.cards a:hover {
				border-color: var(--mango);
			}
			.cards strong {
				color: #fff;
				font-size: 18px;
			}
			.cards span {
				font-size: 15px;
				line-height: 1.5;
				color: var(--screen-soft);
			}
			.cards small {
				margin-top: auto;
				font-family: ui-monospace, monospace;
				font-size: 12px;
				color: var(--mango);
			}
			.rows {
				list-style: none;
				padding: 0;
				margin: 0 0 16px;
			}
			.rows li {
				display: flex;
				justify-content: space-between;
				gap: 16px;
				flex-wrap: wrap;
				padding: 12px 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}
			.rows span {
				color: var(--screen-soft);
				font-size: 15px;
			}

			/* ---------------------------------------------------------------- the open book */
			.book-bar {
				position: fixed;
				z-index: 25;
				left: 50%;
				bottom: 20px;
				transform: translate(-50%, 12px);
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 8px 10px;
				border-radius: 999px;
				background: rgba(20, 22, 28, 0.82);
				border: 1px solid rgba(241, 237, 228, 0.12);
				backdrop-filter: blur(10px);
				color: #f1ede4;
				font-size: 14px;
				white-space: nowrap;
				opacity: 0;
				transition:
					opacity 0.35s ease,
					transform 0.35s ease;
			}
			.book-bar:global(.open) {
				opacity: 1;
				transform: translate(-50%, 0);
			}
			.book-bar .pill {
				color: #f1ede4;
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(255, 255, 255, 0.16);
			}
			.book-bar .pill:disabled {
				opacity: 0.35;
				cursor: default;
			}
			:global(.sr-only) {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
			}

			.fallback {
				position: absolute;
				inset: 0;
				display: grid;
				place-content: center;
				text-align: center;
				padding: 0 16px;
			}
			.fallback[hidden] {
				display: none;
			}
			.fallback a {
				color: var(--desk-ink);
			}

			@media (prefers-reduced-motion: reduce) {
				.card,
				.screen,
				.book-bar {
					transition: none;
				}
			}
		</style>
	</body>
</html>
